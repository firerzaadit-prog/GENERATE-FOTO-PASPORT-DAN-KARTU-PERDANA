   "parameters": {
    "jsCode": "// Ambil file gambar dari pesan Telegram (foto biasa ATAU file gambar/document)\nconst m = $json.message || {};\nconst chatId = String(m.chat?.id ?? '');\nlet fileId = null;\n\nif (Array.isArray(m.photo) && m.photo.length) {\n  // Telegram mengirim beberapa resolusi, ambil yang terbesar (elemen terakhir)\n  fileId = m.photo[m.photo.length - 1].file_id;\n} else if (m.document && String(m.document.mime_type || '').startsWith('image/')) {\n  fileId = m.document.file_id;\n}\n\nreturn [{\n  json: {\n    chat_id: chatId,\n    message_id: m.message_id,\n    file_id: fileId,\n    has_image: !!fileId,\n    received_at: Date.now(),\n  },\n}];"
   },
