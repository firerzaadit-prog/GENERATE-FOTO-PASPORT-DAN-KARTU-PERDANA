  {
   "parameters": {
    "jsCode": "// Ubah base64 hasil OpenAI menjadi file binary\nconst b64 = $json.data?.[0]?.b64_json;\nif (!b64) throw new Error('Respons AI Image tidak berisi b64_json: ' + JSON.stringify($json).slice(0, 500));\nconst binary = await this.helpers.prepareBinaryData(Buffer.from(b64, 'base64'), 'ai-image-1.png', 'image/png');\nreturn [{ json: { label: 'ai1' }, binary: { data: binary } }];"
   },
