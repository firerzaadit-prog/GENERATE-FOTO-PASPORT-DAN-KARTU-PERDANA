      "parameters": {
        "jsCode": "// Tiga pesan dari satu album Telegram memicu 3 execution terpisah.\n// Hanya execution milik pesan TERAKHIR (message_id terbesar) yang melanjutkan flow.\nconst me = $('Parse Message').first().json;\nconst rows = $input.all().map(i => i.json).filter(r => r.file_id);\n\n// Abaikan sisa baris basi (>60 detik) dari kiriman sebelumnya\nconst recent = rows.filter(r => Math.abs(Number(r.received_at) - Number(me.received_at)) <= 60000);\nif (!recent.length) return [];\n\nconst maxId = Math.max(...recent.map(r => Number(r.message_id)));\nif (Number(me.message_id) !== maxId) return []; // bukan leader -> stop\n\nrecent.sort((a, b) => Number(a.message_id) - Number(b.message_id));\n\nreturn [{\n  json: {\n    chat_id: me.chat_id,\n    count: recent.length,\n    files: recent.map(r => ({ file_id: r.file_id, message_id: r.message_id })),\n  },\n}];"
      },
