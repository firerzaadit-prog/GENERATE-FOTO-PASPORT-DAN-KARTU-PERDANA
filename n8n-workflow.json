    "jsCode": "// Pasangkan folder baru dengan 2 hasil AI (urutan Merge: input1 = AI Image 1, input2 = AI Image 2)\nconst folderId = $input.first().json.id;\nconst stamp = $('Create Run Folder').first().json.name; // nama folder unik, dipakai juga sebagai prefix file\nconst results = $('Merge AI Results').all();\nreturn results.map((it, i) => {\n  const binary = { data: { ...it.binary.data, fileName: `${stamp}_AI-Image-${i + 1}.png` } };\n  return { json: { folderId, fileName: `${stamp}_AI-Image-${i + 1}.png` }, binary };\n});"
   },
