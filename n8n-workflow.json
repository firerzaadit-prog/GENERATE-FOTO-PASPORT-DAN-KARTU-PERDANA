  {
   "parameters": {
    "jsCode": "// Gabungkan 3 hasil download menjadi 1 item dengan 3 binary bernama.\n// URUTAN KIRIM = PERAN GAMBAR (ubah di sini bila klien memakai urutan lain):\n//   gambar ke-1 -> paspor\n//   gambar ke-2 -> kartu  (kartu perdana / provider)\n//   gambar ke-3 -> foto   (gambar ketiga, mis. foto orang / selfie)\nconst items = $input.all();\nconst names = ['paspor', 'kartu', 'foto'];\nconst binary = {};\nitems.forEach((it, i) => {\n  const b = it.binary.data;\n  if (!String(b.mimeType || '').startsWith('image/')) b.mimeType = 'image/jpeg';\n  const ext = b.mimeType.split('/')[1].replace('jpeg', 'jpg');\n  b.fileName = `${names[i]}.${ext}`;\n  binary[names[i]] = b;\n});\nreturn [{\n  json: { chat_id: $('Select Leader').first().json.chat_id },\n  binary,\n}];"
   },
